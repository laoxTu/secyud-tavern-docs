  <diagram id="arch-page-2" name="生成时序">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="st1" value="一次 AI 回复的完整时序（realms.generate）" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="46" as="geometry" />
        </mxCell>

        <mxCell id="s_user" value="① 用户提交输入&#10;realms.generate(true)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="680" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_builder" value="② iframe 输入改写&#10;window.userInput.inputBuilders 按 sequence 依次 build(text)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="190" width="680" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_history" value="③ 历史合并判定&#10;上一条已有输出 → 新建历史（继承变量）&#10;上一条无输出 → 追加 prompt 合并" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="290" width="680" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s_window" value="④ 取上下文窗口&#10;倒序回溯 histories，遇 summary === true 停止&#10;走到头则补 opening（开场白）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="680" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s_init" value="⑤ Processer.init 建缓存（进入故事时执行一次）&#10;regexes / macros / tools / lorebooks / memories&#10;结果缓存进 realm.context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="530" width="560" height="100" as="geometry" />
        </mxCell>

        <mxCell id="s_g1" value="⑥-1 regexes&#10;按 target=input 过滤&#10;→ converts.push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="680" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s_g2" value="⑥-2 macros&#10;Eta 求值&#10;→ converts.push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="680" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s_g3" value="⑥-3 tools&#10;组装工具池&#10;（排除 disabled）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="680" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s_g4" value="⑥-4 lorebooks&#10;匹配 + 分层&#10;→ injects.push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="950" y="680" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s_g5" value="⑥-5 memories&#10;注入召回结果&#10;→ injects.push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1240" y="680" width="270" height="90" as="geometry" />
        </mxCell>

        <mxCell id="s_assemble" value="⑦ engine.prompt 组装消息&#10;每条历史：before(i) → user → middle(i) → assistant → behind(i)&#10;四个回调：prompt / assist / system / caller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="820" width="680" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s_api" value="⑧ POST /api/models/{id}/engine/generate&#10;流式 → sseUtils.pack 包装为 text/event-stream&#10;非流式 → JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="950" width="680" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s_engine" value="⑨ 服务端引擎&#10;hasher.decrypt(key, iv) 解密 API Key&#10;→ OpenAI / DeepSeek / Anthropic SDK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1070" width="680" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s_retry" value="⚑ 内层：重试循环&#10;网络错误 或 流式卡死超过 interval 秒&#10;→ controller.abort('retry') → 重试（默认 max=3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="950" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s_stream" value="⑩ 前端逐块解析&#10;sseUtils.read → engine.result(ctx)&#10;写入 output.{content, thought, callings}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1190" width="680" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s_toolcall" value="⑪ 工具调用分支&#10;tools.calling 执行 → 结果写回 callings[i].result&#10;异常写为 &quot;error: ...&quot; 回灌给模型（不中断生成）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1310" width="680" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s_loop" value="⑫ 工具循环判定&#10;stopped 为假？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;perimeter=rhombusPerimeter;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="1430" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s_render" value="⑬ 流式渲染 renderers.stream&#10;正则在宏之前 → converts 链 → postMessage&#10;仅在「当前页是最新」时才渲染" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1590" width="680" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s_output" value="⑭ Processer.output 收尾&#10;世界书匹配结果落进 message.properties&#10;供历史重放复现，不必重算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1710" width="680" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s_save" value="⑮ 落库&#10;history.outputs.push(输出组)&#10;stories.proxy.history.set" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="1830" width="680" height="110" as="geometry" />
        </mxCell>

        <mxCell id="s_note1" value="★ 关键：世界书的 knowledge 角色&#10;不直接进消息列表，而是伪装成一次&#10;get_knowledge 工具调用的返回值&#10;→ 复用工具通道，零新增概念，天然兼容所有供应商" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=18;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="2000" width="680" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s_note2" value="★ 变量是 JSON Patch 补丁序列&#10;每条消息带 variables: Operation[]&#10;工具写值只是 push 一个操作，而非直接改状态&#10;→ 翻页可回放、重新生成不污染状态" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=18;fillColor=#EAF3FF;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="2000" width="680" height="140" as="geometry" />
        </mxCell>

        <mxCell id="se1" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s_user" target="s_builder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se2" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s_builder" target="s_history">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se3" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s_history" target="s_window">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se4" value="Processer 依次执行" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_window" target="s_g1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se5" value="requires" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_g1" target="s_g2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se6" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s_g2" target="s_g4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se7" value="requires" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_g3" target="s_g4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se8" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s_g5" target="s_assemble">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se9" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s_g4" target="s_assemble">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se10" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s_assemble" target="s_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se11" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s_api" target="s_engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se12" value="SSE 流" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_engine" target="s_stream">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se13" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s_stream" target="s_toolcall">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se14" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s_toolcall" target="s_loop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se15" value="未结束：带工具结果重新请求" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;strokeColor=#B85450;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_loop" target="s_assemble">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se16" value="已结束" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_loop" target="s_render">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se17" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s_render" target="s_output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se18" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s_output" target="s_save">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se19" value="重试" style="endArrow=classic;html=1;rounded=1;strokeWidth=1;strokeColor=#B85450;edgeStyle=orthogonalEdgeStyle;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_retry" target="s_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se20" value="先于生成" style="endArrow=classic;html=1;rounded=1;strokeWidth=1;strokeColor=#D6B656;edgeStyle=orthogonalEdgeStyle;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s_init" target="s_g1">
