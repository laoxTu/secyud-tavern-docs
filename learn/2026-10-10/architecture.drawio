  <diagram id="arch-page-3" name="模块契约">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="m1" value="模块契约：目录骨架 · 注册表 · 扩展点" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1720" height="46" as="geometry" />
        </mxCell>

        <mxCell id="tree" value="src/&lt;模块&gt;/&#10;├── index.ts　　　　类型、常量、元信息（导出 name / plural 一对）&#10;├── manifest.json　　模块声明 { id, client, server, requires, sequence }&#10;├── client/　　　　　浏览器侧（此目录下文件自动加 'use client'）&#10;│　　├── index.tsx　　　default 导出 = 注册函数&#10;│　　├── content.tsx　　编辑 UI&#10;│　　├── state.ts　　　 zustand store&#10;│　　├── proxy.ts　　　接口封装&#10;│　　└── realm.ts　　　Processer / Renderer 实现&#10;├── server/　　　　　服务端&#10;│　　├── api.ts　　　　 接口定义 → 自动生成 Next.js 路由&#10;│　　├── schema.ts　　　Drizzle 表定义&#10;│　　├── repository.ts　仓储 CRUD&#10;│　　├── storage.ts　　 条目序列化 / 归档钩子&#10;│　　└── factory.ts　　　通用工厂&#10;└── localization/　　zh.json + en.json（必须成对更新）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1060" height="440" as="geometry" />
        </mxCell>

        <mxCell id="reg_title" value="主要注册表（Registry，共 12 个）" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="90" width="620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="reg1" value="global-menu　侧边栏菜单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="130" width="620" height="36" as="geometry" />
        </mxCell>
